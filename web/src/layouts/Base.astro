---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';
import '@fontsource/literata/400.css';
import '@fontsource/literata/600.css';
import '@fontsource/literata/400-italic.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  /** Raw JSON-LD object, serialised into a script tag. */
  jsonLd?: Record<string, unknown>;
  ogType?: string;
}

const { title, description, canonical, jsonLd, ogType = 'website' } = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="OmniShelf" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#f7f5f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a18" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" hreflang="en" href={url} />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    {SITE.analytics.umamiSrc && SITE.analytics.umamiWebsiteId && (
      <script
        defer
        src={SITE.analytics.umamiSrc}
        data-website-id={SITE.analytics.umamiWebsiteId}
      />
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the text</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Count calls to action without any third party: one listener, no cookies.
      document.addEventListener('click', function (event) {
        var el = event.target;
        while (el && el !== document.body && !(el.dataset && el.dataset.track)) el = el.parentElement;
        if (!el || !el.dataset || !el.dataset.track) return;
        try {
          if (window.umami && typeof window.umami.track === 'function') {
            window.umami.track(el.dataset.track, { src: el.dataset.src || 'unknown' });
          }
        } catch (error) {}
      });
    </script>
  </body>
</html>
