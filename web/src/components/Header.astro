---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const items = [
  { href: '/reading-craft/', label: 'Reading Craft' },
  { href: '/where-to-read/', label: 'Where to Read' },
  { href: '/reading-life/', label: 'Reading Life' },
  { href: '/about/', label: 'About' },
  { href: '/shelf/', label: 'Shelf' },
];

const isCurrent = (href: string) => path.startsWith(href.replace(/\/$/, ''));
---

<header class="site-header">
  <div class="shell">
    <a class="wordmark" href="/">OmniShelf<span>a reader's notebook</span></a>
    <nav class="site-nav" aria-label="Sections">
      {items.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
