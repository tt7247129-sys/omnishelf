---
interface Props {
  caption?: string;
  /** Kept for future per-source codes; the file is regenerated by scripts/make-site-qr.sh. */
  image?: string;
}

const { caption = 'Scan to open the download page on your phone', image = '/qr/play.svg' } =
  Astro.props;
---

<figure class="qr">
  <img src={image} width="360" height="360" alt="QR code for the OmniShelf download page" loading="lazy" />
  <figcaption>{caption}</figcaption>
</figure>
