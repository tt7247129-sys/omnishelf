---
interface Props {
  href: string;
  title: string;
  summary: string;
  date: string;
  readingMinutes?: number;
}

const { href, title, summary, date, readingMinutes } = Astro.props;
const display = new Date(date).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<li>
  <a class="card" href={href}>
    <h2>{title}</h2>
    <p class="card-summary">{summary}</p>
    <p class="meta">
      <time datetime={date}>{display}</time>
      {readingMinutes ? ` · ${readingMinutes} min` : ''}
    </p>
  </a>
</li>

<style>
  .card {
    display: block;
    padding: var(--space-4) 0;
    color: inherit;
    text-decoration: none;
  }

  .card h2 {
    font-size: var(--step-1);
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-2);
    color: var(--ink);
  }

  .card:hover h2 {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  .card-summary {
    margin: 0 0 var(--space-2);
    color: var(--ink-soft);
  }

  .card .meta {
    margin: 0;
  }
</style>
