---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';

export async function getStaticPaths() {
  const notes = (await getCollection('articles')).sort((a, b) => a.data.order - b.data.order);
  return notes.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, next: notes[index + 1] ?? null },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const url = new URL(`/notes/${entry.id}/`, Astro.site).href;
const display = new Date(entry.data.date).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.summary,
  datePublished: entry.data.date,
  dateModified: entry.data.date,
  mainEntityOfPage: url,
  author: { '@type': 'Organization', name: 'OmniShelf' },
  publisher: { '@type': 'Organization', name: 'OmniShelf' },
};
---

<Base title={`${entry.data.title} — OmniShelf`} description={entry.data.summary} jsonLd={jsonLd} ogType="article">
  <div class="shell">
    <Prose>
      <p class="meta">
        Reading Notes · <time datetime={entry.data.date}>{display}</time>
        {` · ${entry.data.readingMinutes} min`}
      </p>
      <p class="byline">By <a href="/authors/">@tt7247129-sys</a></p>
      <h1>{entry.data.title}</h1>
      <Content />
    </Prose>

    <aside class="author-note">
      <p class="meta">About the author</p>
      <p>
        <strong>@tt7247129-sys</strong> builds an open-source Android reader and writes these notes.
        {entry.data.authorNote ?? 'These are engineering notes: what the reader does, and why it does it that way.'}
        {' '}<a href="/authors/">More about the author</a>.
      </p>
    </aside>

    {next && (
      <nav class="next-note" aria-label="Next note">
        <p class="meta">Next note</p>
        <a href={`/notes/${next.id}/`}>{next.data.title}</a>
      </nav>
    )}
  </div>
</Base>

<style>
  .byline {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin: calc(var(--space-2) * -1) 0 var(--space-3);
  }

  .author-note {
    max-width: var(--measure);
    border-top: 1px solid var(--rule);
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .next-note {
    border-top: 1px solid var(--rule);
    margin-top: var(--space-5);
    padding-top: var(--space-3);
  }

  .next-note a {
    font-size: var(--step-1);
  }
</style>
