---
import { getEntry } from 'astro:content';
import Page from '../layouts/Page.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const entry = await getEntry('pages', 'index');
const notes = (await getCollection('articles'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Page entry={entry}>
  <hr />

  <section class="prose">
    <h2>Reading Notes</h2>
    <p class="meta">Essays, published as they are finished. <a href="/notes/">All notes →</a></p>
  </section>

  <ul class="note-list">
    {notes.map((note) => (
      <ArticleCard
        href={`/notes/${note.id}/`}
        title={note.data.title}
        summary={note.data.summary}
        date={note.data.date}
        readingMinutes={note.data.readingMinutes}
      />
    ))}
  </ul>
</Page>
