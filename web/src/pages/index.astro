---
import { getEntry } from 'astro:content';
import Page from '../layouts/Page.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection, getEntry } from 'astro:content';

const entry = await getEntry('pages', 'index');
const columns = [
  { collection: 'readingCraft' as const, path: '/reading-craft/' },
  { collection: 'whereToRead' as const, path: '/where-to-read/' },
  { collection: 'readingLife' as const, path: '/reading-life/' },
];

const cards = [];
for (const column of columns) {
  for (const item of await getCollection(column.collection)) {
    cards.push({
      href: `${column.path}${item.id}/`,
      title: item.data.title,
      summary: item.data.description,
      date: item.data.pubDate,
      readingMinutes: item.data.readingMinutes,
    });
  }
}
for (const note of await getCollection('articles')) {
  cards.push({
    href: `/notes/${note.id}/`,
    title: note.data.title,
    summary: note.data.summary,
    date: note.data.date,
    readingMinutes: note.data.readingMinutes,
  });
}
cards.sort((a, b) => (a.date < b.date ? 1 : -1));
---

<Page entry={entry} jsonLd={{
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'OmniShelf',
  applicationCategory: 'BookApplication',
  operatingSystem: 'Android 7.0+',
  url: 'https://omnishelf.cc',
  downloadUrl: 'https://play.google.com/store/apps/details?id=cc.omnishelf.reader',
  installUrl: 'https://github.com/tt7247129-sys/omnishelf/releases',
  softwareVersion: '1.1.0',
  license: 'https://www.gnu.org/licenses/agpl-3.0.html',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    '34 ebook and document formats including PDF, EPUB, MOBI, AZW3, FB2, DJVU, CBZ and CBR',
    'Offline text-to-speech with the device voice',
    'Highlights, notes and bookmarks',
    'OPDS catalogues',
    '54 interface languages',
    'No advertising, analytics or tracking code',
  ],
}}>
  <hr />

  <section class="prose">
    <p class="meta">
      Newest first · <a href="/reading-craft/">Reading Craft</a> ·
      <a href="/where-to-read/">Where to Read</a> ·
      <a href="/reading-life/">Reading Life</a> ·
      <a href="/notes/">Engineering notes</a>
    </p>
  </section>

  <ul class="note-list">
    {cards.map((card) => (
      <ArticleCard
        href={card.href}
        title={card.title}
        summary={card.summary}
        date={card.date}
        readingMinutes={card.readingMinutes}
      />
    ))}
  </ul>
</Page>
