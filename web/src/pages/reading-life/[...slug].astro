---
import { getCollection } from 'astro:content';
import ColumnArticle from '../../layouts/ColumnArticle.astro';

export async function getStaticPaths() {
  const items = await getCollection('readingLife');
  return items.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;
const items = await getCollection('readingLife');
const entry = items.find((item) => item.id === slug);
if (!entry) throw new Error(`unknown reading-life entry: ${slug}`);
---

<ColumnArticle entry={entry} collection="readingLife" />
