<?xml version="1.0" encoding="utf-8"?>
<!-- The reading position, on the cover itself: a corner label rather than a line of
     text under the title, which is where the eye goes when scanning a shelf. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/omni_primary" />
    <corners android:radius="10dp" />
</shape>
